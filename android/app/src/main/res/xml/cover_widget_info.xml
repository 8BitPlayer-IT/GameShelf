<?xml version="1.0" encoding="utf-8"?>
<!-- Android aggiorna i widget al massimo ogni 30 minuti: qui ogni ora. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/cover_widget_description"
    android:initialLayout="@layout/cover_widget"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="70dp"
    android:minResizeHeight="70dp"
    android:previewLayout="@layout/cover_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen" />
