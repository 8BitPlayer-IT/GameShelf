<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 e successivi. Su alcuni telefoni allowBackup="false" non blocca il
  trasferimento da dispositivo a dispositivo: qui sono esclusi esplicitamente sia il
  backup su cloud sia il trasferimento diretto.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
